<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  UpScale Scouting Tool daily home-IP Atlas harvest.

  Fires once a day at 20:00 LOCAL time — evening for the owner, chosen so the
  harvest lands while the laptop is open (a missed day = no new games that
  day; Atlas discovers nothing on its own). Moved from 19:00 to 20:00 on
  2026-09-23: the 19:00 fire kept colliding with the Wi-Fi/VPN re-key and
  DNS on this network, and atlasdev.gg lookups failed wholesale
  (NameResolutionError storm in logs/atlas_home_run.err). The throttle inside
  atlas_home.py is 23h so a fixed daily slot can never silently skip a day.

  Install (one time):
    mkdir -p ~/Library/LaunchAgents
    cp com.rbxscout.atlas-home-harvest.plist ~/Library/LaunchAgents/
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.rbxscout.atlas-home-harvest.plist

  Check / run manually:
    launchctl print gui/$(id -u)/com.rbxscout.atlas-home-harvest
    launchctl kickstart gui/$(id -u)/com.rbxscout.atlas-home-harvest
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.rbxscout.atlas-home-harvest</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/adityamanshukhani/Downloads/Open-Cowork-main/Discord Website/.venv/bin/python</string>
        <string>/Users/adityamanshukhani/Downloads/Open-Cowork-main/Discord Website/atlas_home.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/adityamanshukhani/Downloads/Open-Cowork-main/Discord Website</string>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>20</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/adityamanshukhani/Downloads/Open-Cowork-main/Discord Website/logs/atlas_home_run.out</string>
    <key>StandardErrorPath</key>
    <string>/Users/adityamanshukhani/Downloads/Open-Cowork-main/Discord Website/logs/atlas_home_run.err</string>

    <!-- Incident 2026-10-02..04: launchd's default 256-file soft cap starved
         the harvest of file descriptors — leaked WAL connections (3 fds each,
         since fixed in scout_core._ClosingConnection) pushed the run past the
         cap mid-flight, and EVERY open then failed: "unable to open database
         file" on sqlite AND bogus "Failed to resolve" DNS errors (getaddrinfo
         needs an fd too). Code now closes its connections, but 256 is still
         tight for pull + harvest + backfill + sweep in one process — raise it
         so one slow descriptor can never again end the run. -->
    <key>SoftResourceLimits</key>
    <dict>
        <key>NumberOfFiles</key>
        <integer>2048</integer>
    </dict>

    <key>Nice</key>
    <integer>10</integer>
</dict>
</plist>
