# Never bake local secrets or heavyweight artifacts into the image.
rbx_scout.db
rbx_scout.db*
contacts.key
contacts_backup.bundle
local_cookie.txt
local_cookie2.txt
.cookie

.venv/
venv/
__pycache__/
*.pyc
.pytest_cache/

logs/
logs/*
.github/

# Dev-only content the container never needs.
tests/
node_modules/
*.md
!README.md
.streamlit/secrets.toml
