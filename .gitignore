# --- local environment ---
.venv/
venv/
__pycache__/
*.pyc
.pytest_cache/
.DS_Store

# --- editor / tooling noise ---
.idea/
.vscode/
*.swp
.freebuff/

# --- streamlit local secrets (never commit real secrets) ---
.streamlit/secrets.toml

# --- dev scratch ---
*.log
/tmp/
logs/

# --- home harvester artifacts (atlas_home.py) ---
rbx_scout.db.harvest
rbx_scout.db.remote_merge
rbx_scout.db.pull
*.out
*.err

# --- cloudflare worker (tooling only; source + wrangler.toml stay committed) ---
cloudflare-worker/node_modules/
cloudflare-worker/.wrangler/

# --- sqlite WAL sidecars (folded into the .db by checkpointing) ---
*.db-wal
*.db-shm
*.db.tmp

# --- per-device profiles (contain the remembered Roblox cookie — NEVER commit) ---
.profiles/

# --- password-gate state (attempt counters + unlocked-device memory) ---
.gate_lock.json
.gate_unlocked.json

# --- private notes (delete these lines to publish) ---
GAMES_DB_PLAN.md
implementation_plan.md
FIXES.md
# assets/ IS published: the welcome-flow cookie-guide screenshots
# (Step 1-4 SS.png) must ship with the app for the guide to render.

# NOTE: rbx_scout.db and rbx_scout.db.sync_state are NOT in git anymore.
