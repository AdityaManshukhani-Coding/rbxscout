GAMES_DB_PLAN.md
implementation_plan.md
FIXES.md
assets/

# NOTE: rbx_scout.db and rbx_scout.db.sync_state are NOT in git anymore.
# The catalog is the `rbx_scout.db` asset of the rolling Release tag
# `catalog-latest` in this repo — pull/push it with `python db_sync.py`.
# Git stays for code; the Release asset is the database.
rbx_scout.db
rbx_scout.db.sync_state
